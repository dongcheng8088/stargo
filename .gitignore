# ===================== Go 构建产物 =====================
# 编译生成的可执行文件（bin/stargo 是 go build 产物）
bin/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# go test 覆盖率输出
*.cover
*.coverprofile
coverage.out

# go build 生成的临时目录
/tmp/
/build/

# ===================== 依赖与缓存 =====================
# 仅当使用 vendor 模式时才取消注释，否则 Go modules 用 go.sum 即可
# vendor/

# ===================== 日志与运行时文件 =====================
*.log
log.txt
*.log.*

# 配置中可能动态生成的 PID、socket
*.pid
*.sock

# ===================== IDE / 编辑器 =====================
# VS Code / Trae
.trae/

# JetBrains (GoLand/IDEA)
.idea/
*.iml
*.ipr
*.iws

# Vim 交换文件
*.swp
*.swo
*~
.*.swp
.*.swo

# Emacs
\#*\#
*#
.#*

# ===================== 操作系统 =====================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ===================== 备份文件 =====================
*.bak
*.backup
*.orig
*.rej
*.old
cluster/scaleOut.bak/

# ===================== 环境与敏感配置 =====================
# 含真实主机/密码/密钥的本地配置文件不入库
.env
.env.*
!.env.example

# 本地集群配置（可能含真实 IP/密码），模板保留
sr-c1.yaml
sr-c1.json
importTest.yaml
# deploy-template.yaml 是模板，需保留入库，故不忽略
# repo.yaml 如需团队共享则保留；含私有仓库地址时可取消注释
# repo.yaml

# ===================== 其他 =====================
# 临时测试文件
*.tmp
*.temp