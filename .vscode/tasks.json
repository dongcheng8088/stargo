{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "构建stargo",
      "type": "shell",
      "command": "go",
      "args": ["build", "-v", "-o", "${workspaceFolder}/bin/stargo", "."],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build"
    },
    {
      "label": "同步配置到bin",
      "type": "shell",
      "command": "bash",
      "args": ["${workspaceFolder}/scripts/sync-conf.sh"],
      "options": { "cwd": "${workspaceFolder}" }
    }
  ]
}